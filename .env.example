# ===== 应用 =====
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
# 允许访问的前端来源（Vercel 生产域名 + preview 域名 + 本地开发）
CORS_ORIGINS=http://localhost:3000

# ===== 数据库（Neon Serverless Postgres，需支持 pgvector）=====
# 建议使用 pooled connection（-pooler 结尾的 host）
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/agentops?sslmode=require

# ===== 缓存（可选；留空则自动降级为进程内缓存）=====
REDIS_URL=

# ===== 模型（OpenAI 兼容协议，可填 DeepSeek / Qwen / OpenAI）=====
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com        LLM_MODEL=deepseek-chat
# 通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 成本档位：cheap 用于分类/改写等轻任务，strong 用于规划/生成
LLM_MODEL_CHEAP=deepseek-chat
LLM_MODEL_STRONG=deepseek-chat

# ===== Embedding（留空则 RAG 自动降级为 BM25 纯关键词检索）=====
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ===== Rerank（可选；关闭则跳过二次排序）=====
RERANK_ENABLED=false
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3

# ===== 可观测（可选）=====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 安全 =====
# 简易接口鉴权，留空则不启用
API_TOKEN=
